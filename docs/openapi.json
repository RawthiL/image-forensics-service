  "components": {
    "schemas": {
      "AnalysisResponse": {
        "properties": {
          "scope": {
            "type": "string",
            "title": "Scope",
            "description": "How much of the file was examined. `container` means the pixels were never looked at, so a `clean` is the far weaker statement."
          },
          "verdict": {
            "type": "string",
            "title": "Verdict",
            "description": "clean | suspicious | malicious"
          },
          "injection": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Injection",
            "description": "Highest finding score"
          },
          "severity": {
            "type": "string",
            "title": "Severity",
            "description": "Highest finding severity"
          },
          "findings": {
            "items": {
              "$ref": "#/components/schemas/FindingOut"
            },
            "type": "array",
            "title": "Findings"
          },
          "upstreams": {
            "additionalProperties": {
              "$ref": "#/components/schemas/UpstreamOut"
            },
            "type": "object",
            "title": "Upstreams",
            "description": "Which composed services actually ran. A check that was skipped or unreachable says so here rather than being silently absent. Empty at container scope, which composes nothing."
          },
          "views_rendered": {
            "type": "integer",
            "title": "Views Rendered"
          },
          "pipeline_fingerprint": {
            "type": "string",
            "title": "Pipeline Fingerprint",
            "description": "Everything that decides the answer at this scope"
          },
          "elapsed_ms": {
            "type": "number",
            "title": "Elapsed Ms"
          }
        },
        "type": "object",
        "required": [
          "scope",
          "verdict",
          "injection",
          "severity",
          "findings",
          "views_rendered",
          "pipeline_fingerprint",
          "elapsed_ms"
        ],
        "title": "AnalysisResponse"
      },
