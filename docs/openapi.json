    "securitySchemes": {
      "ServiceApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Key gating one endpoint. This is a deployment boundary, not user authentication -- it carries no caller identity. Distinct from the vendor keys on the compatibility routes, which are accepted and ignored.\n\nKeys are listed per endpoint under `endpoints.<name>.api_keys`, and a key opens only the endpoints that list it. An empty list leaves that endpoint open. `/v1/models` accepts any served endpoint's key and answers with the sections that key is entitled to."
      },
      "ServiceBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "The same key as ServiceApiKey, sent as `Authorization: Bearer <key>`. Only the Bearer scheme is read: `Authorization: token ...` on a compatibility route is a vendor credential and stays ignored."
      }
    }
