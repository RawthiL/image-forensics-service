    "securitySchemes": {
      "ServiceApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Single shared key gating the deployment. Set server-side via IFS_API_KEY; when unset, every route is open. This is a deployment boundary, not user authentication -- it carries no caller identity. Distinct from the vendor keys on the compatibility routes, which are accepted and ignored."
      },
      "ServiceBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "The same key as ServiceApiKey, sent as `Authorization: Bearer <key>`. Only the Bearer scheme is read: `Authorization: token ...` on a compatibility route is a vendor credential and stays ignored."
      }
    }
